rules_version = '2';

// ============================================================
//  NRCC Work Permit System — Firestore Security Rules
//  Deploy with: firebase deploy --only firestore:rules
//  (or paste into Firebase Console → Firestore → Rules)
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- helpers ----
    function signedIn() { return request.auth != null; }
    function userDoc() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function hasUser() { return exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function role() { return hasUser() ? userDoc().role : 'none'; }
    function isAdmin()  { return signedIn() && role() == 'admin'; }
    function isIssuer() { return signedIn() && role() == 'issuer'; }
    function isIsolator() { return signedIn() && role() == 'isolator'; }
    // Issuer-or-Admin can do everything an Issuer can:
    function canIssue() { return isAdmin() || isIssuer(); }
    function isActive() { return hasUser() && userDoc().active == true; }
    // True only before any user exists — used to let the very first
    // signed-in account bootstrap itself as Administrator.
    function noUsersYet() {
      return !exists(/databases/$(database)/documents/meta/init);
    }
    // On a permit update the approval / rejection / closure / requester fields
    // are the audit trail. On every NON-Issuer update path they must stay byte
    // -for-byte unchanged. This is what stops a requester (or isolator) from
    // forging an approval to self-activate a permit, or rewriting who raised it.
    function permitAuditLocked() {
      return request.resource.data.approval == resource.data.approval
        && request.resource.data.rejection == resource.data.rejection
        && request.resource.data.closure == resource.data.closure
        && request.resource.data.requester == resource.data.requester;
    }

    // ---- trial run (a sub-document on the isolation certificate) ----
    // A trial run temporarily energises isolated equipment so a crew can prove
    // a repair. The record lives on the certificate — that is the thing whose
    // locks come off and go back on, and one certificate may carry several
    // crews. See app.js §6 for the six lifecycle writes.
    //
    // The steps that ENERGISE (status → trialRun) and re-isolate (status →
    // active) write the certificate's status, so they fall through to the
    // Isolator/Admin clause below: no requester and no Issuer can reach them.
    // What these functions add is the crew-facing half — asking for a trial,
    // clearing one, refusing one, calling one off — which no existing clause
    // permitted at all.

    // Only the trial-run sub-document may move. Never status, points, or any
    // signature field on the certificate itself.
    function trialFieldsOnly() {
      return request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['trialRun', 'trialRunLog'])
        && resource.data.status == 'active'
        && request.resource.data.status == 'active';
    }
    // The history is append-only for EVERY role, Issuers and Admins included:
    // entries may be added, never removed or rewritten. An incident review has
    // to be able to trust it.
    function trialLogAppendOnly() {
      return request.resource.data.get('trialRunLog', []).hasAll(resource.data.get('trialRunLog', []))
        && request.resource.data.get('trialRunLog', []).size()
             <= resource.data.get('trialRunLog', []).size() + 1;
    }
    // Exactly one entry was appended to the log this write.
    function trialLogGrewByOne() {
      return request.resource.data.get('trialRunLog', []).size()
               == resource.data.get('trialRunLog', []).size() + 1;
    }
    function trialLastLogEntry() {
      return request.resource.data.trialRunLog[request.resource.data.trialRunLog.size() - 1];
    }
    // The caller personally owns a permit that is live and attached to THIS
    // certificate — i.e. they are one of the crews this lockout is holding.
    // This is what stops any signed-in user from speaking for a crew.
    // Split in two so the permit is fetched ONCE rather than once per clause.
    // A rules evaluation is capped at ten document accesses, and each of the
    // three write shapes below may reach this check; the callers also put it
    // last so the cheap field comparisons short-circuit first.
    function crewPermitOk(isoId, p) {
      return p.requester.uid == request.auth.uid
        && p.isolationRef == isoId
        && p.status in ['active', 'extended'];
    }
    function ownsCrewPermit(isoId, permitId) {
      return permitId is string
        && exists(/databases/$(database)/documents/permits/$(permitId))
        && crewPermitOk(isoId, get(/databases/$(database)/documents/permits/$(permitId)).data);
    }

    // Raising the request: no trial in flight, it starts unauthorised, and the
    // crew named on it must be the caller's own.
    function trialRequestWrite(isoId) {
      return resource.data.get('trialRun', null) == null
        && request.resource.data.get('trialRun', null) != null
        && request.resource.data.trialRun.status == 'requested'
        && request.resource.data.trialRun.get('issuerApproval', null) == null
        && request.resource.data.trialRun.requestedBy.uid == request.auth.uid
        && request.resource.data.trialRun.consents.size() == 1
        && request.resource.data.get('trialRunLog', []).size() == resource.data.get('trialRunLog', []).size()
        && ownsCrewPermit(isoId, request.resource.data.trialRun.permitId);
    }
    // Clearing the trial: exactly one answer appended at the end, every earlier
    // answer preserved, and it speaks for a permit the caller owns. The stage
    // and the Issuer's signature line cannot move on this path.
    function trialConsentWrite(isoId) {
      return resource.data.get('trialRun', null) != null
        && request.resource.data.get('trialRun', null) != null
        && resource.data.trialRun.status == 'requested'
        && request.resource.data.trialRun.status == 'requested'
        && request.resource.data.trialRun.permitId == resource.data.trialRun.permitId
        && request.resource.data.trialRun.get('issuerApproval', null) == null
        && request.resource.data.get('trialRunLog', []).size() == resource.data.get('trialRunLog', []).size()
        // The crew's own estimate of how long it will take is what the overrun
        // alarm is measured against, so nobody else may quietly stretch it.
        && request.resource.data.trialRun.get('expectedMinutes', null) == resource.data.trialRun.get('expectedMinutes', null)
        && request.resource.data.trialRun.consents.hasAll(resource.data.trialRun.consents)
        && request.resource.data.trialRun.consents.size() == resource.data.trialRun.consents.size() + 1
        && request.resource.data.trialRun.consents[request.resource.data.trialRun.consents.size() - 1].uid == request.auth.uid
        && ownsCrewPermit(isoId, request.resource.data.trialRun.consents[request.resource.data.trialRun.consents.size() - 1].permitId);
    }
    // Ending it before anything was energised — a crew refusing, or the crew
    // that asked (or an Issuer, via the clause below) calling it off. The
    // request is cleared and exactly one closed entry is appended.
    function trialCloseWrite(isoId) {
      return resource.data.get('trialRun', null) != null
        && request.resource.data.get('trialRun', null) == null
        && trialLogGrewByOne()
        && trialLastLogEntry().closedBy.uid == request.auth.uid
        && (
          (trialLastLogEntry().outcome == 'refused'
            && ownsCrewPermit(isoId, trialLastLogEntry().consents[trialLastLogEntry().consents.size() - 1].permitId))
          ||
          (trialLastLogEntry().outcome == 'cancelled'
            && ownsCrewPermit(isoId, resource.data.trialRun.permitId))
        );
    }
    // The crew saying the trial has served its purpose, so the Isolator knows to
    // re-apply the locks. This is the ONE crew write that happens while the
    // equipment is energised, so it is scoped separately and tightly: the
    // certificate stays in trialRun, the trial stays energised, and nothing
    // about how it got there may move. It records a request, not a state change
    // — only the Isolator's write ends the trial.
    function trialDoneWrite(isoId) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['trialRun'])
        && resource.data.status == 'trialRun'
        && request.resource.data.status == 'trialRun'
        && resource.data.get('trialRun', null) != null
        && resource.data.trialRun.status == 'energised'
        && request.resource.data.trialRun.status == 'energised'
        && resource.data.trialRun.get('completedBy', null) == null
        && request.resource.data.trialRun.completedBy.uid == request.auth.uid
        // Everything that records how the equipment came to be live is frozen.
        && request.resource.data.trialRun.permitId == resource.data.trialRun.permitId
        && request.resource.data.trialRun.requestedBy == resource.data.trialRun.requestedBy
        && request.resource.data.trialRun.consents == resource.data.trialRun.consents
        && request.resource.data.trialRun.issuerApproval == resource.data.trialRun.issuerApproval
        && request.resource.data.trialRun.deisolatedBy == resource.data.trialRun.deisolatedBy
        && request.resource.data.trialRun.deisolatedAt == resource.data.trialRun.deisolatedAt
        // Signing off must not also rewrite the estimate it is being judged against.
        && request.resource.data.trialRun.get('expectedMinutes', null) == resource.data.trialRun.get('expectedMinutes', null)
        && ownsCrewPermit(isoId, resource.data.trialRun.permitId);
    }
    // The whole crew-facing permission, in one place.
    function crewTrialWrite(isoId) {
      return (trialFieldsOnly()
                && (trialRequestWrite(isoId) || trialConsentWrite(isoId) || trialCloseWrite(isoId)))
        || trialDoneWrite(isoId);
    }
    // Transitions that mean a person physically handled locks: applying them
    // (assigned → active), taking them out for a trial (active → trialRun) and
    // putting them back (trialRun → active). Reserved for the Isolator, with
    // Admin as the system superuser. An Issuer creates certificates, assigns
    // them and authorises trial runs — but must never sign that locks moved.
    //
    // The two trial transitions are here because the emulator suite proved
    // they were not: canIssue() reached every status change that was not
    // assigned → active, so an Issuer could energise isolated equipment
    // directly, whatever the UI showed and whatever the transaction checked.
    function isLockHandlingTransition() {
      return (resource.data.status == 'assigned' && request.resource.data.status == 'active')
        || (resource.data.status == 'active' && request.resource.data.status == 'trialRun')
        || (resource.data.status == 'trialRun' && request.resource.data.status == 'active');
    }

    // ---- users ----
    match /users/{uid} {
      // A person can always read their OWN profile (needed at sign-in to learn
      // their role / active state before any UI renders). Reading other people's
      // profiles — names, emails, employee numbers — is limited to active users
      // (Issuers/Admins assigning work, the Admin console). A pending or
      // anonymous account cannot enumerate staff.
      allow read: if signedIn() && (request.auth.uid == uid || isActive());
      // A person may create their own profile. They may set role 'admin'
      // ONLY during first-run bootstrap; otherwise self-signups are 'requester'.
      allow create: if signedIn() && request.auth.uid == uid && (
        (noUsersYet() && request.resource.data.role == 'admin') ||
        request.resource.data.role == 'requester'
      );
      // Only an Admin can change roles / activate users.
      allow update, delete: if isAdmin();
    }

    // ---- meta (bootstrap marker, written once) ----
    // Readable by any signed-in account so the app can detect first-run before a
    // profile exists; only an Admin (or the very first user) may write it.
    match /meta/{doc} {
      allow read: if signedIn();
      allow write: if isAdmin() || (signedIn() && doc == 'init' && noUsersYet());
    }

    // ---- config (permit types, lines, areas, departments) ----
    // Low-sensitivity reference data; readable by any signed-in account so the
    // sign-up form can populate the configured departments / job titles.
    match /config/{doc} {
      allow read: if signedIn();
      allow write: if isAdmin() || (signedIn() && noUsersYet()); // seed at bootstrap
    }

    // ---- equipment ----
    match /equipment/{id} {
      allow read: if isActive();
      // Issuer/Admin create & maintain equipment.
      allow create: if canIssue() && isActive();
      // Issuer/Admin may update freely; any active Isolator may update an item
      // that is part of an isolation lifecycle (i.e. has an active certificate)
      // so they can set isolated / available when confirming isolation or
      // de-isolation. They cannot touch equipment with no active isolation.
      allow update: if isActive() && (
        canIssue() ||
        (isIsolator() && resource.data.activeIsolationId != null)
      );
      allow delete: if isAdmin();
    }

    // ---- isolations (certificates) ----
    match /isolations/{id} {
      allow read: if isActive();
      allow create: if canIssue() && isActive();
      // Issuer/Admin manage certificates (create, assign, release); any active
      // Isolator may confirm isolation or de-isolation (whoever is on shift),
      // not just the named assignee. The ONE transition reserved for the
      // Isolator is confirming the physical isolation is applied — the
      // assigned → active step. An Issuer creates and assigns the certificate
      // but must never sign that the locks are on; that role separation is
      // enforced here, not just hidden in the UI. (Admin kept as superuser.)
      // The trial-run history is append-only on EVERY path, including the
      // Issuer's and the Isolator's — see trialLogAppendOnly().
      allow update: if isActive() && trialLogAppendOnly() && (
        isLockHandlingTransition()
          ? (isIsolator() || isAdmin())
          // A crew may also reach this document, but only through the
          // trial-run sub-document and only in the ways crewTrialWrite allows.
          : (canIssue() || isIsolator() || crewTrialWrite(id))
      );
      allow delete: if isAdmin();
    }

    // ---- permits ----
    match /permits/{id} {
      allow read: if isActive();
      // Any active user may raise a permit (as the requester). A new permit may
      // only start as a draft or submitted — never pre-approved / active — and
      // must not arrive with a forged approval / completion / closure / isolation
      // already stamped on it (those fields are only ever written by the roles
      // that own them, later in the lifecycle).
      allow create: if isActive()
                    && request.resource.data.requester.uid == request.auth.uid
                    && request.resource.data.status in ['draft', 'submitted']
                    && request.resource.data.get('approval', null) == null
                    && request.resource.data.get('rejection', null) == null
                    && request.resource.data.get('closure', null) == null
                    && request.resource.data.get('workCompletion', null) == null
                    && request.resource.data.get('isolationRef', null) == null
                    && request.resource.data.get('trialRuns', []).size() == 0;
      // Update paths (audit fields stay locked on every non-Issuer path):
      //  • Issuer/Admin — full authority (records approval/closure/rejection…).
      //  • Requester editing their own draft/submitted permit — the new status
      //    must stay within draft/submitted (so they can never self-approve to
      //    active), and the audit fields are locked.
      //  • Requester recording work-completion on their own active/extended
      //    permit — the status must not change.
      //  • Isolator activating a permit (awaitingIsolation → active) when they
      //    confirm the certificate it is attached to.
      allow update: if isActive() && (
        canIssue() ||
        (resource.data.requester.uid == request.auth.uid &&
         resource.data.status in ['draft', 'submitted'] &&
         request.resource.data.status in ['draft', 'submitted'] &&
         permitAuditLocked() &&
         // Identity / audit anchors a requester may never rewrite on edit:
         request.resource.data.permitNo == resource.data.permitNo &&
         request.resource.data.createdAt == resource.data.createdAt &&
         request.resource.data.get('workCompletion', null) == resource.data.get('workCompletion', null) &&
         request.resource.data.get('isolationRef', null) == resource.data.get('isolationRef', null)) ||
        // Requester on their own live permit may ONLY record work completion.
        // (Previously this path allowed rewriting validity — i.e. a requester
        // could silently self-extend their own permit — plus gas test,
        // checklist and equipment fields. Now field-locked.)
        (resource.data.requester.uid == request.auth.uid &&
         resource.data.status in ['active', 'extended'] &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['workCompletion', 'updatedAt'])) ||
        // Isolator activating an approved permit: status flip only.
        (isIsolator() &&
         resource.data.status == 'awaitingIsolation' &&
         resource.data.isolationRef != null &&
         request.resource.data.status == 'active' &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['status', 'updatedAt'])) ||
        // Isolator closing out a trial run recorded by the earlier flow, which
        // kept its record on the permit instead of on the certificate. Only
        // that legacy array moves, and only on a permit attached to a lockout —
        // it is what stops the log claiming the equipment is still energised
        // after the locks have gone back on.
        (isIsolator() &&
         resource.data.isolationRef != null &&
         request.resource.data.status == resource.data.status &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['trialRuns', 'updatedAt']))
      );
      allow delete: if isAdmin();
    }
  }
}
